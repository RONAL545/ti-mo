---
import {brand,navigation,services,values,steps,projects,faqs,testimonials,showDemoTestimonials,articles} from '../content';
import EditorialArt from '../components/EditorialArt.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import Product from '../components/Product.astro';
import '../styles/global.css';
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Software a medida para empresas e instituciones públicas. Sitios web, e-commerce, ERP, aplicaciones móviles e integraciones con Ti & Mo."/><meta name="theme-color" content="#1565c0"/><meta property="og:title" content="Ti & Mo | Desarrollo de software a medida"/><meta property="og:description" content="Diseño y desarrollo de soluciones digitales alineadas con tu organización."/><meta property="og:type" content="website"/><title>Ti & Mo | Desarrollo de software a medida</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:brand.name,email:brand.email})}/></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a><header><div class="container header-inner"><a href="#inicio" aria-label="Ti & Mo, inicio"><Brand/></a><button id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Abrir menú">Menú <span>☰</span></button><nav id="navigation" aria-label="Navegación principal">{navigation.map(([label,id])=><a href={'#'+id}>{label}</a>)}<a class="button small" href="#contacto">Conversemos <Icon size={17}/></a></nav></div></header>
<main id="contenido"><section class="hero" id="inicio"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><i></i> DESARROLLO DE SOFTWARE A MEDIDA</span><h1>Convertimos tus ideas en software que <span>impulsa tu organización.</span></h1><p>{brand.intro}</p><div class="hero-actions"><a class="button" href="#contacto">Cuéntanos tu proyecto <Icon size={19}/></a><a class="text-link" href="#servicios">Explorar servicios <span>↗</span></a></div><div class="hero-support"><span><Icon name="check" size={15}/> Soluciones a medida</span><span><Icon name="check" size={15}/> Comunicación directa</span><span><Icon name="check" size={15}/> Enfoque en tus objetivos</span></div></div><div class="hero-art" data-tilt><div class="hero-orb orb-a" aria-hidden="true"></div><div class="hero-orb orb-b" aria-hidden="true"></div><div class="art-grid"></div><div class="floating-label label-top"><span class="code-icon">&lt;/&gt;</span><span>De la idea<br/><b>a la solución.</b></span></div><Product id="hero"/><div class="floating-label label-bottom"><span class="connected-icon"><Icon name="check"/></span><span>Tecnología que conecta<br/><b>personas y procesos</b></span></div><span class="visual-note">UNA VISTA DE LO QUE PODEMOS CONSTRUIR JUNTOS</span></div></div></section>
<div class="audience-strip"><div class="container"><span>SOFTWARE CON PROPÓSITO</span><p>Para empresas que evolucionan.</p><span class="strip-plus">+</span><p>Para instituciones que avanzan.</p><span class="strip-arrow">↗</span></div></div>
<section id="servicios" class="section container"><div class="section-heading"><div><span class="eyebrow">01 / LO QUE HACEMOS</span><h2>Tu siguiente paso digital.<br/><span>Construido a tu medida.</span></h2></div><p>Cada organización tiene sus propios retos.<br/>Creamos la solución que tiene sentido para la tuya.</p></div><div class="services-grid">{services.map((s,i)=><a class:list={['service-card',{'service-wide':i===6}]} href="#contacto" data-service={s.title}><div class="service-top"><span class="icon-box"><Icon name={s.icon}/></span><span class="service-number">0{i+1}</span></div><div><h3>{s.title}</h3><p>{s.text}</p></div><span class="service-cta">Hablemos de {i===6?'tu integración':'tu proyecto'} <Icon size={19}/></span></a>)}</div></section>
<section class="organizations"><div class="container"><div class="section-heading"><div><span class="eyebrow">DIFERENTES RETOS. UN MISMO ENFOQUE.</span><h2>Entendemos tu contexto.</h2></div><p>Posibles soluciones que se adaptan a cómo trabaja tu organización.</p></div><div class="org-grid"><article><span class="org-symbol">↗</span><span class="eyebrow">SECTOR PRIVADO</span><h3>Empresas privadas</h3><p>Conecta tus operaciones y crea nuevas oportunidades para tu negocio.</p><div class="tags"><span>Ventas e inventario</span><span>Comercio digital</span><span>Atención al cliente</span><span>Operaciones</span></div></article><article><span class="org-symbol"><Icon name="grid" size={38}/></span><span class="eyebrow">SECTOR PÚBLICO</span><h3>Instituciones públicas</h3><p>Herramientas pensadas para organizar la gestión y acercar los servicios a las personas.</p><div class="tags"><span>Gestión documental</span><span>Trámites</span><span>Reportes</span><span>Atención ciudadana</span></div></article></div></div></section>
<section id="nosotros" class="section container"><div class="about-grid"><div class="about-heading"><span class="eyebrow">02 / SOMOS TI & MO</span><h2>La tecnología importa.<br/><span>Las personas, también.</span></h2><p>{brand.about}</p><div class="team"><span class="team-avatars"><i>ET</i><i>JM</i></span><div><small>GERENCIA GENERAL</small><b>{brand.team.join(' y ')}</b></div></div></div><div class="purpose"><article><span>01 — NUESTRA MISIÓN</span><p>{brand.mission}</p></article><article><span>02 — NUESTRA VISIÓN</span><p>{brand.vision}</p></article></div></div><div class="values">{values.map(([title,text])=><article><Icon name="check" size={20}/><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section id="proceso" class="process section"><div class="container"><div class="section-heading"><div><span class="eyebrow">03 / CÓMO TRABAJAMOS</span><h2>Una buena solución empieza<br/>con una buena conversación.</h2></div><p>Un proceso claro, con espacio para escuchar, validar y avanzar juntos.</p></div><div class="steps">{steps.map(([title,text],i)=><article><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section id="proyectos" class="section container"><div class="section-heading"><div><span class="eyebrow">04 / IDEAS EN ACCIÓN</span><h2>Imagina lo que<br/><span>podemos crear contigo.</span></h2></div><p>Ejemplos visuales para explorar posibilidades.<br/>Son conceptos, no proyectos de clientes.</p></div><div class="projects">{projects.map(p=><article class="project-card"><div class={'project-art '+p.type} data-tilt><Product type={p.type}/></div><span class="concept-label">Proyecto conceptual · demostración</span><h3>{p.title}</h3><p>{p.text}</p></article>)}</div></section>
{showDemoTestimonials&&<section class="testimonials-section section" id="resenas"><div class="container"><div class="section-heading"><div><span class="eyebrow">VOCES DE UN ESCENARIO POSIBLE</span><h2>Así se podría sentir<br/><span>trabajar en una buena idea.</span></h2></div><p class="academic-note">Ejercicio para el curso de marketing. Todos los testimonios de esta sección son ficticios; no representan clientes ni experiencias verificadas.</p></div><div class="testimonials-grid">{testimonials.map(([quote,author],i)=><article class="quote-card"><span class="quote-mark" aria-hidden="true">“</span><span class="fiction-label">Testimonio ficticio de ejemplo</span><blockquote>{quote}</blockquote><div class="quote-author"><span class="quote-avatar" aria-hidden="true">{['OP','EC','AD'][i]}</span><p>{author}</p></div><span class="quote-topic">{['GESTIÓN MÁS CLARA','COMERCIO MÁS SIMPLE','INFORMACIÓN MÁS CERCA'][i]}</span></article>)}</div><p class="academic-caption">Contenido de demostración académica · Sin valoraciones de clientes reales</p></div></section>}
<section id="blog" class="section container blog-section"><div class="section-heading"><div><span class="eyebrow">IDEAS PARA TU SIGUIENTE PASO</span><h2>Tecnología que se entiende.<br/><span>Ideas que se comparten.</span></h2></div><p>Un espacio editorial sobre marketing, diseño y software. Contenido educativo creado para este proyecto académico.</p></div><div class="blog-grid">{articles.map(a=><article class="blog-card"><a href={'/blog/'+a.slug+'/'} class="blog-image" aria-label={'Leer: '+a.title}><EditorialArt type={a.type}/><span class="article-arrow"><Icon/></span></a><div class="blog-meta"><span>{a.category}</span><span>{a.read} de lectura</span></div><h3><a href={'/blog/'+a.slug+'/'}>{a.title}</a></h3><p>{a.excerpt}</p><a class="text-link" href={'/blog/'+a.slug+'/'}>Leer artículo <Icon size={18}/></a></article>)}</div></section>
<section class="faq-section section"><div class="container faq-grid"><div><span class="eyebrow">ANTES DE EMPEZAR</span><h2>Resolvamos<br/><span>tus dudas.</span></h2><p>Y si tienes alguna más,<br/><a href="#contacto" class="text-link">conversemos <Icon size={18}/></a></p></div><div class="faqs">{faqs.map(([question,answer])=><details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section id="contacto" class="section container"><div class="contact-grid"><div class="contact-copy"><span class="eyebrow">05 / EMPECEMOS ALGO BUENO</span><h2>Hablemos de tu<br/><span>próximo proyecto.</span></h2><p>Cuéntanos qué necesitas mejorar o qué idea quieres hacer realidad. El primer paso es conocernos.</p><div class="contact-email"><span class="icon-box"><Icon name="mail"/></span><div><small>ESCRÍBENOS</small><a href={'mailto:'+brand.email}>{brand.email}</a></div></div><button class="copy-email" type="button">Copiar correo <span>↗</span></button><p class="copy-status" role="status" id="email-status"></p><div class="contact-note"><span>Tu idea es el punto de partida.</span><p>Nosotros te ayudamos a encontrar el camino tecnológico.</p></div></div><form id="contact-form" novalidate><div class="form-pair"><div><label for="name">Nombre <span>*</span></label><input id="name" name="name" autocomplete="name" required placeholder="¿Cómo te llamas?" maxlength="100"/><small class="error" id="name-error"></small></div><div><label for="organization">Organización <span>(opcional)</span></label><input id="organization" name="organization" autocomplete="organization" placeholder="Empresa o institución" maxlength="150"/></div></div><label for="email">Correo electrónico <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" required placeholder="tu@organizacion.com" maxlength="200"/><small class="error" id="email-error"></small><label for="service">Servicio de interés <span>*</span></label><select id="service" name="service" required><option value="">Selecciona una opción</option>{services.map(s=><option>{s.title}</option>)}<option>Necesito orientación</option></select><small class="error" id="service-error"></small><label for="message">Cuéntanos sobre tu proyecto <span>*</span></label><textarea id="message" name="message" rows="4" required placeholder="¿Qué te gustaría construir o mejorar?" maxlength="4000"></textarea><small class="error" id="message-error"></small><p class="form-help">Se abrirá tu aplicación de correo para que revises y envíes el mensaje. No envíes información sensible.</p><div class="form-actions"><button class="button" type="submit">Preparar correo <Icon size={18}/></button><button type="button" id="copy-message" class="text-link">Copiar mensaje</button></div><p id="form-status" role="status"></p><div id="copy-fallback" hidden><label for="prepared-message">Copia el mensaje manualmente:</label><textarea id="prepared-message" readonly rows="7"></textarea></div></form></div></section></main>
<footer><div class="container footer-top"><div><a href="#inicio" aria-label="Ti & Mo, volver al inicio"><Brand/></a><p>Ideas claras. Software a medida.<br/>Tecnología para seguir avanzando.</p></div><div><span>EXPLORA</span><nav aria-label="Navegación del pie">{navigation.map(([label,id])=><a href={'#'+id}>{label}</a>)}</nav></div><div><span>CONECTEMOS</span><a href={'mailto:'+brand.email}>{brand.email} ↗</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Ti & Mo. Todos los derechos reservados.</span><span>Proyecto académico de marketing · Hecho con propósito.</span></div></footer>
<script>
import '../motion';
import {brand} from '../content';
const toggle=document.querySelector<HTMLButtonElement>('#menu-toggle')!;
const nav=document.querySelector<HTMLElement>('#navigation')!;
const closeMenu=()=>{toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Abrir menú');nav.classList.remove('open');};
toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Cerrar menú':'Abrir menú');nav.classList.toggle('open',open);});
nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus();}});
const service=document.querySelector<HTMLSelectElement>('#service')!;
document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(a=>a.addEventListener('click',()=>{service.value=a.dataset.service!;service.dispatchEvent(new Event('input'));}));
document.querySelector('.copy-email')!.addEventListener('click',async()=>{const status=document.querySelector('#email-status')!;try{await navigator.clipboard.writeText(brand.email);status.textContent='Correo copiado.';}catch{status.textContent='No se pudo copiar automáticamente. Selecciona el correo que aparece arriba y cópialo manualmente.';}});
const form=document.querySelector<HTMLFormElement>('#contact-form')!;
const status=document.querySelector<HTMLElement>('#form-status')!;
const required=['name','email','service','message'];
const validate=()=>{let first:HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement|null=null;for(const id of required){const el=document.getElementById(id) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement;const error=document.getElementById(id+'-error')!;const valid=!!el.value.trim()&&el.validity.valid;el.setAttribute('aria-invalid',String(!valid));el.setAttribute('aria-describedby',id+'-error');error.textContent=valid?'':id==='email'?'Introduce un correo electrónico válido.':'Completa este campo para continuar.';if(!valid&&!first)first=el;}first?.focus();return !first;};
for(const id of required)document.getElementById(id)!.addEventListener('input',()=>{document.getElementById(id)!.removeAttribute('aria-invalid');document.getElementById(id+'-error')!.textContent='';});
const message=()=>{const d=new FormData(form);return `Hola, Ti & Mo:\n\nNombre: ${d.get('name')}\nOrganización: ${d.get('organization')||'No indicada'}\nCorreo: ${d.get('email')}\nServicio: ${d.get('service')}\n\nProyecto:\n${d.get('message')}`;};
form.addEventListener('submit',e=>{e.preventDefault();if(!validate())return;window.location.href=`mailto:${brand.email}?subject=${encodeURIComponent('Consulta de proyecto: '+service.value)}&body=${encodeURIComponent(message())}`;status.textContent='Correo preparado. Revisa y envía el mensaje desde tu aplicación de correo. Si no se abre, usa «Copiar mensaje».';});
document.getElementById('copy-message')!.addEventListener('click',async()=>{if(!validate())return;try{await navigator.clipboard.writeText(message());status.textContent='Mensaje copiado. Pégalo en un correo dirigido a '+brand.email+'.';document.getElementById('copy-fallback')!.hidden=true;}catch{document.getElementById('copy-fallback')!.hidden=false;const output=document.querySelector<HTMLTextAreaElement>('#prepared-message')!;output.value=message();output.focus();output.select();status.textContent='La copia automática no está disponible. Puedes copiar el texto seleccionado manualmente.';}});
</script></body></html>
